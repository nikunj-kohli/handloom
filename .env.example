# ---------------------------------------------------------------
# Handover Lens — environment
# Copy to .env and fill in. NEVER commit .env.
# Everything here stays server-side; the browser never sees these.
# ---------------------------------------------------------------

# --- Optional LLM (the app works fully without any key) ---------
# auto | groq | gemini | openai | anthropic | xai | offline
LLM_PROVIDER=auto
# Leave blank to use the provider default.
LLM_MODEL=
# Groq (Llama and friends). Keys start with gsk_
GROQ_API_KEY=
# xAI Grok. Keys start with xai-
XAI_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_TIMEOUT_SECONDS=45
LLM_MAX_OUTPUT_TOKENS=2600
# Hard spend guard: total model calls allowed per UTC day, across all users.
DAILY_LLM_CALL_CAP=400

# --- Optional GitHub read-only token ----------------------------
# Without it: 60 requests/hour and live ingestion will be rate limited.
GITHUB_TOKEN=
GITHUB_MAX_COMMITS=120
GITHUB_MAX_PULLS=80
GITHUB_MAX_COMMIT_DETAIL=40

# --- Storage ----------------------------------------------------
# Default: local SQLite. Set a Postgres URL on Render/Neon instead.
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
HANDOVER_DATA_DIR=./data
SESSION_TTL_HOURS=72

# --- Limits -----------------------------------------------------
MAX_UPLOAD_BYTES=2000000
MAX_UPLOAD_FILES=8
MAX_TOTAL_UPLOAD_BYTES=6000000
RATE_LIMIT_PER_MINUTE=120
HEAVY_RATE_LIMIT_PER_MINUTE=8
MAX_CONCURRENT_GENERATIONS=2

# Set to 0 if you are not behind a trusted proxy (Render/Fly are).
TRUST_PROXY=1
